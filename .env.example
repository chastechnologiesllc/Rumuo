# rumuo-platform/.env.example
# Copy to .env and fill in values. Never commit .env.

# ── Supabase Postgres connection ──────────────────────────────────────────────
# Get from: Supabase dashboard → Project → Settings → Database → Connection string
# Use the "URI" format.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to "true" to log all SQL queries (development only)
DB_ECHO=false

# ── Review Console auth ───────────────────────────────────────────────────────
# A hard-to-guess token that reviewers send as X-Reviewer-Token header.
# Replace with proper auth before adding multiple reviewers.
REVIEWER_TOKEN=change-me-before-production

# ── Service ports (for local development) ─────────────────────────────────────
EXPERIENCE_API_PORT=8000
REVIEW_CONSOLE_PORT=8001
